# Copy to `.env` next to docker-compose.yml and edit. `docker compose up -d` does the rest.

# Who may use this instance.
#   accounts  key-based accounts (and optional OAuth): for anything reachable from the internet.
#             Put it behind a TLS reverse proxy so clients connect over https:// and wss://.
#   none      no accounts at all: every document is open to everyone who can reach the server.
#             For a home server, a LAN or a VPN. Never expose it to the internet.
AUTH=accounts

# The address clients use to reach the server, with no path: https://write.example.com
# Signatures are bound to it, and OAuth callbacks are built from it. Behind a reverse proxy set
# it (and TRUST_PROXY=true), so the server does not guess the scheme from the request.
PUBLIC_URL=http://localhost:8080
TRUST_PROXY=false

# Published port on the host.
PORT=8080

# Image tag: latest, or a release such as v1.0.0.
IMAGE_TAG=latest

# The database. Change the password; the server and PostgreSQL both read it from here.
POSTGRES_PASSWORD=change-me

# Requests per minute and client IP on the sign-in, OAuth and ticket endpoints.
RATE_LIMIT_PER_MINUTE=30

# Stored Yjs updates per document before the server compacts them into a snapshot.
COMPACT_AFTER=200

# Sign in with GitHub: register an OAuth app whose callback URL is
#   <PUBLIC_URL>/api/oauth/github/callback
# The button is hidden while these are empty. (Ignored with AUTH=none.)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Any OpenID Connect provider (Google, GitLab, Keycloak, …); callback URL
#   <PUBLIC_URL>/api/oauth/oidc/callback
OAUTH_OIDC_ISSUER=
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_NAME=Single sign-on
