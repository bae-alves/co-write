# Defaults match docker-compose.yml; the server reads these from the process environment.
PORT=8080
APP_VERSION=0.0.0-dev
DATABASE_URL=jdbc:postgresql://localhost:5432/cowrite
DATABASE_USER=cowrite
DATABASE_PASSWORD=cowrite
# Comma-separated host[:port] values allowed by CORS (the Vite dev server by default).
CORS_ALLOWED_HOSTS=localhost:5173
# Stored Yjs updates per document before the server compacts them into a snapshot.
COMPACT_AFTER=200

# accounts (default): key-based accounts, optional OAuth, per-document roles.
# none: no accounts; every document open to everyone who can reach the server (LAN / VPN only).
AUTH=accounts
# The address clients reach the server at (no path). Signatures are bound to it and OAuth
# callbacks are built from it. Unset: taken from each request.
PUBLIC_URL=http://localhost:8080
# Behind a reverse proxy: read the client IP and scheme from X-Forwarded-* headers.
TRUST_PROXY=false
# Requests per minute and client IP on the sign-in, OAuth and ticket endpoints.
RATE_LIMIT_PER_MINUTE=30
# Optional OAuth providers (hidden while unset; ignored with AUTH=none). Callback URLs:
#   <PUBLIC_URL>/api/oauth/github/callback and <PUBLIC_URL>/api/oauth/oidc/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_OIDC_ISSUER=
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_NAME=Single sign-on
