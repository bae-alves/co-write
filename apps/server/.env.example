# Defaults match docker-compose.yml; the server reads these from the process environment.
PORT=8080
APP_VERSION=0.0.0-dev
DATABASE_URL=jdbc:postgresql://localhost:5432/cowrite
DATABASE_USER=cowrite
DATABASE_PASSWORD=cowrite
# Comma-separated host[:port] values allowed by CORS (the Vite dev server by default).
CORS_ALLOWED_HOSTS=localhost:5173
